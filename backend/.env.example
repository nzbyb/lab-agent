# ============================================================
# 环境变量模板
#
# 用法：复制本文件为同目录下的 .env，再填入真实值
#   Windows :  copy backend\.env.example backend\.env
#   macOS/Linux :  cp backend/.env.example backend/.env
#
# ⚠️ .env 已被根目录 .gitignore 忽略，请勿把真实密钥提交到仓库
# ============================================================

# ---------- 数据库 ----------
# 格式：mysql+pymysql://用户名:密码@主机:端口/库名?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/lab_agent?charset=utf8mb4

# ---------- JWT 鉴权 ----------
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 长度至少 32 位；若使用本行的示例值，后端启动时会直接报错（见 app/config.py）
JWT_SECRET_KEY=please_generate_a_random_secret_at_least_32_chars
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256

# ---------- 大模型 ----------
# 需为 OpenAI 兼容接口（提供 /chat/completions）
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=your-model-name
LLM_BASE_URL=https://your-llm-endpoint/v1

# ---------- 邮件（验证码 + 预约结果通知，可选） ----------
# 留空 = 邮箱验证码和通知邮件都不可用；账号密码、手机号登录、站内消息和旧的账号注册照常。
# QQ 邮箱：SMTP_HOST=smtp.qq.com，SMTP_PORT=465，SMTP_USE_SSL=true。
# SMTP_PASSWORD 填 QQ 邮箱的「SMTP 授权码」，不是 QQ 登录密码；授权码只放本地 .env。
SMTP_HOST=
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=智能实验室预约系统
SMTP_TIMEOUT=10

# 验证码 5 分钟过期；同一邮箱 60 秒内只能发一次；最多输错 5 次。
EMAIL_CODE_EXPIRE_MINUTES=5
EMAIL_CODE_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

# 已通过的预约，距开始还有多少小时以上才允许本人自行取消。
# 再近就要找管理员走「强制取消」。改这个值时要同步改知识库 data/kb/预约规则.md。
RESERVATION_CANCEL_DEADLINE_HOURS=2

# ---------- 数据库迁移 ----------
# 默认 false：正常部署由 compose 的 migrate 服务先跑 `python -m app.migrate`。
# 本机直接 uvicorn 图省事，可以改成 true，让启动时自动升到最新。
AUTO_MIGRATE=false

# ---------- 错误监控（Sentry，可选） ----------
# 不填 DSN = 完全关闭，不加载监控代码。填了之后后端 500 会上报到 Sentry。
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# 0 = 只收错误，不收性能追踪（性能追踪会增加额度和开销）。
SENTRY_TRACES_SAMPLE_RATE=0

# ---------- 跨域 ----------
# 逗号分隔。只有前后端分开跑（本机 npm run dev，前端在 5173 端口）时才用得上。
# 上线建议让前后端同域：nginx 把 /api 反代给后端，静态文件交给前端产物。
# 同域时浏览器不发跨域请求，这一项留空也不影响。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
