# ============================================================
# 构建后端镜像时要挡在外面的东西
#
# 这份文件里最重要的一行是 .env —— 里面是真 key，一旦 COPY 进镜像，
# 镜像层会被永久保存在本机（docker history 能挖出来），
# 打上标签推到任何仓库就等于把密钥公开了。
# ============================================================

# ---------- 密钥：绝不可进镜像 ----------
.env
.env.*
!.env.example

# ---------- 本机虚拟环境 ----------
# 镜像里会自己装一份 Linux 的。把 Windows 那份 COPY 进去，
# 里面 .exe 和 .pyd 全是 Windows 二进制，占地方还让 import 行为变得诡异。
.venv/
venv/
env/

# ---------- 测试 ----------
# 运行时用不到；测试要跑是在 CI 里另跑，不该进生产镜像
tests/
pytest.ini
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# ---------- Python 编译产物 ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# ---------- 运行时产物 ----------
# 用户上传的文件属于运行时数据，不该烤进镜像（compose 里挂卷处理）
uploads/

# 向量库索引：里面是按本机路径建的二进制索引，跨机器没意义。
# 镜像里第一次启动会从 data/kb/*.md 自动重建，不需要带过去。
# 注意 data/kb/*.md 本身要留着——那是知识库的源文件，被 git 跟踪的。
data/chroma/

# ---------- 排查用的临时脚本 ----------
# 按根 .gitignore 的约定，这类脚本常抄着真 key 和本机绝对路径
_tmp_*
_probe_*
.tmp_*
*.tmp

# ---------- 日志 ----------
logs/
*.log
