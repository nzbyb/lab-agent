# ============================================================
# Docker Compose 用的环境变量模板（放在仓库根目录）
#
# 用法：
#   Windows :  copy .env.example .env
#   macOS/Linux :  cp .env.example .env
# 然后把下面每个值都改成你自己的。
#
# ⚠️ 这份是给 docker compose 读的，跟 backend/.env 是两码事：
#     - backend/.env   本机直接跑 uvicorn 时用（DATABASE_URL 指向 127.0.0.1:3306）
#     - 根 .env        跑 docker compose 时用（数据库主机名是容器名 mysql）
#   两个都已被 .gitignore 忽略，都不会进仓库。
#
# ⚠️ 这两个文件里的值都不会被拷进镜像——compose 是运行时注入环境变量的。
#    代价是：**必须自己填**，照抄这份模板是起不来的（见下面 JWT_SECRET_KEY 的说明）。
# ============================================================

# ---------- 数据库密码 ----------
# 这是给 MySQL 容器设的 root 密码，随便定一个，不用跟本机那份一样。
# 不要用 123456 这种，虽然只监听本机 3307，但没必要留个洞。
MYSQL_ROOT_PASSWORD=change_me_to_something_random

# ---------- JWT 鉴权 ----------
# 生成方法（随便哪个终端跑一下，把输出贴过来）：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# ⚠️ 下面这行是**故意**写成一个用不了的示例值。
#    后端 app/config.py 启动时会自检，见到它就直接拒绝启动并打印生成方法。
#    这是刻意的：防止有人照抄模板就上线。（跟 backend/.env.example 同一个做法）
JWT_SECRET_KEY=please_generate_a_random_secret_at_least_32_chars
JWT_EXPIRE_HOURS=24

# ---------- 大模型 ----------
# 需要是 OpenAI 兼容接口（提供 /chat/completions）
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=your-model-name
LLM_BASE_URL=https://your-llm-endpoint/v1

# ---------- 跨域 ----------
# 前后端同源（都从 8080 进，nginx 反代），浏览器不发跨域请求，留空就行。
# 只有你把前端单独跑在本机 5173（npm run dev）时才需要填。
CORS_ORIGINS=

# ---------- 限流计数器（可选）----------
# 不用填。docker-compose.yml 默认已经指向容器里的 Redis（redis://redis:6379/0），
# 留空的含义是"用后端进程内存"，只有本机直接跑 uvicorn 时才会走到这条。
# 想连外部 Redis 时再把下面这行的注释去掉、改成你的地址：
# REDIS_URL=redis://redis:6379/0

# ---------- QQ 邮箱验证码 + 预约结果通知（可选）----------
# 不填就是关掉邮箱验证码和通知邮件；账号密码、手机号登录、站内消息和旧的账号注册照常。
# SMTP_PASSWORD 填 QQ 邮箱的「SMTP 授权码」，不是 QQ 登录密码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=智能实验室预约系统
SMTP_TIMEOUT=10

# 验证码 5 分钟过期；同一邮箱 60 秒内只能发一次；最多输错 5 次。
EMAIL_CODE_EXPIRE_MINUTES=5
EMAIL_CODE_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

# ---------- 数据库迁移 ----------
# compose 里的 migrate 服务会先跑 `python -m app.migrate`，backend 启动时不要再跑一遍。
# 保持 false。只有本机直接 uvicorn、又懒得分两步时才改成 true。
AUTO_MIGRATE=false

# ---------- 错误监控（Sentry，可选）----------
# 不填 DSN = 完全关闭。填了之后后端 500 会自动上报到这里。
# traces_sample_rate=0 表示只收错误，不收性能追踪。
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0

# ---------- 时区 ----------
# 影响"现在几点"的判断（AI 答"现在哪些实验室开放"、预约时校验开始时间）。
# 不填默认上海。填错会导致 AI 的开放时间答案整体偏移，别的看不出来。
TZ=Asia/Shanghai

# ---------- pip 源（可选，只在构建镜像时用）----------
# 默认走官方源，本机/CI/国外部署都不用管这两行。
# 在国内服务器上构建时**必须**改，否则官方 PyPI 常常连不上、
# download.pytorch.org 实测只有十几 KB/s（torch 有 200 多兆）。
# 阿里云 ECS 上实测：PyPI 镜像 16 MB/s、pytorch-wheels 13 MB/s。
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
TORCH_INDEX_URL=https://mirrors.aliyun.com/pytorch-wheels/cpu

# ---------- embedding 模型缓存目录（可选）----------
# 第一次启动会去 HuggingFace 下 BAAI/bge-small-zh-v1.5（约 92MB）。
# 不填就落在仓库根的 ./.hf-cache/，下次启动直接复用。
# 如果你本机已经有这个模型，把下面这行的注释去掉、路径改成你自己的，能省掉那次下载。
# HF_CACHE_DIR=C:/Users/你的用户名/.cache/huggingface
