# ============================================================
# 智能实验室预约系统 · 根目录 .gitignore
# ⚠️ 本文件必须在 git init 之前存在，否则 .env 里的密钥会被提交
# ============================================================

# ---------- 密钥与环境变量（最高优先级，绝不可提交）----------
.env
.env.*
!.env.example

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
ENV/
build/
develop-eggs/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# ---------- Node ----------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.eslintcache

# ---------- 运行时产物（可重新生成，不入库）----------
backend/uploads/
backend/data/chroma/

# ---------- 临时文件 ----------
.tmp_*
*.tmp
tmp/
temp/

# ---------- 日志 ----------
logs/
*.log

# ---------- 编辑器 / 操作系统 ----------
.idea/
.vscode/*
!.vscode/launch.json
!.vscode/extensions.json
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.tsbuildinfo

# ---------- 前端构建脚本产物 ----------
frontend/scripts/*.timestamp-*.mjs
